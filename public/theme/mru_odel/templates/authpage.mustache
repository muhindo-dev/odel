{{!
    @template theme_mru_odel/authpage
    MRU ODEL Auth page layout — branded split layout with generic content area.
    Used for registration, password reset, and other auth-related pages.

    Example context (json):
    {
        "sitename": "MRU ODEL",
        "output": {},
        "bodyattributes": "",
        "siteyear": "2026",
        "wwwroot": ""
    }
}}
{{> theme_mru_odel/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
{{{ output.standard_top_of_body_html }}}

<div class="mru-login-wrapper" id="page-wrapper">

    {{! ── Left: Brand panel (hidden < lg) ── }}
    <div class="mru-login-brand d-none d-lg-flex"
         style="background-image: url('{{{wwwroot}}}/theme/mru_odel/pix/frontpage/students.jpg');">
        <div class="brand-overlay"></div>

        <div class="brand-top">
            <a href="{{{wwwroot}}}" class="login-logo">MRU<span class="accent">ODEL</span></a>
            <p class="login-university">Muteesa I Royal University</p>
        </div>

        <div class="brand-center">
            <h2 class="brand-tagline">Join MRU ODEL</h2>
            <p class="brand-desc">Create your account to access courses, assignments and resources through the Open &amp; Distance E-Learning portal.</p>
            <div class="login-badges">
                <span class="login-badge"><i class="fa fa-shield" aria-hidden="true"></i> Chartered 2024</span>
                <span class="login-badge"><i class="fa fa-certificate" aria-hidden="true"></i> NCHE Licensed</span>
            </div>
        </div>

        <div class="brand-bottom">
            <p class="login-motto">
                <span class="motto-line"></span>
                <em>Seeking Greater Horizons In Thoughts And Actions</em>
            </p>
            <div class="login-campus-info">
                <span><i class="fa fa-map-marker" aria-hidden="true"></i> Kakeeka, Mengo &middot; Kirumba, Masaka</span>
                <span><i class="fa fa-phone" aria-hidden="true"></i> +256 414 670109</span>
            </div>
        </div>
    </div>

    {{! ── Right: Content panel ── }}
    <div class="mru-login-form">
        <div class="login-form-scroll">
            <div class="login-form-inner mru-register-wizard">

                {{! Mobile-only top bar }}
                <div class="login-mobile-header d-lg-none">
                    <div class="login-mobile-bar">
                        <div class="login-mobile-icon"><span>M</span></div>
                        <div class="login-mobile-text">
                            <a href="{{{wwwroot}}}" class="login-mobile-brand">MRU<span class="accent">ODEL</span></a>
                            <div class="login-mobile-uni">Muteesa I Royal University</div>
                        </div>
                    </div>
                </div>

                {{! Main content injected by Moodle }}
                <div id="page-content">
                    <div id="region-main-box">
                        <div id="region-main">
                            {{{ output.main_content }}}
                        </div>
                    </div>
                </div>

                {{! Footer }}
                <div class="login-footer-note">
                    <p>&copy; {{siteyear}} Muteesa I Royal University</p>
                    <p>Need help? <a href="mailto:odel@mru.ac.ug">odel@mru.ac.ug</a> &middot; <a href="tel:+256414670109">+256 414 670109</a></p>
                </div>

            </div>
        </div>
    </div>

</div>

{{{ output.standard_end_of_body_html }}}
{{{ output.standard_footer_html }}}

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_mru_odel/theme'], function(Loader, MRUTheme) {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
