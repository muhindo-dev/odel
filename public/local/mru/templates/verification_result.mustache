<div class="local-mru-verification-result">
    {{#verified}}
    <div class="alert alert-success">
        <i class="fa fa-check-circle"></i> {{message}}
    </div>
    {{/verified}}
    {{^verified}}
    <div class="alert alert-danger">
        <i class="fa fa-times-circle"></i> {{message}}
    </div>
    {{/verified}}
</div>
