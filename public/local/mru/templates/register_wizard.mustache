{{!
    @template local_mru/register_wizard
    MRU ODEL Registration Wizard — shell with step indicator + delegated step content.
    Each step's markup lives in its own register_step{N}.mustache partial.

    Example context (json):
    {
        "wwwroot": "",
        "sesskey": "",
        "step": 1,
        "steps": [],
        "step_content": "<div>...</div>"
    }
}}

{{! ── Step header (always visible — tells user exactly where they are) ── }}
<div class="wizard-step-header">
    <span class="wizard-step-counter">Step {{step}} of {{totalsteps}}</span>
    <span class="wizard-step-title">{{active_step_name}}</span>
</div>

{{! ── Progress bar ── }}
<div class="wizard-progress" role="progressbar" aria-valuenow="{{progress_pct}}" aria-valuemin="0" aria-valuemax="100" aria-label="Registration progress {{progress_pct}}%">
    <div class="wizard-progress-fill" style="width:{{progress_pct}}%"></div>
</div>

{{! ── Step indicator ── }}
<div class="wizard-steps" aria-label="Registration steps">
    {{#steps}}
    <div class="wizard-step {{#active}}is-active{{/active}} {{#done}}is-done{{/done}} {{#upcoming}}is-upcoming{{/upcoming}}"{{#active}} aria-current="step"{{/active}}>
        <div class="step-circle">
            {{#done}}<i class="fa fa-check" aria-hidden="true"></i>{{/done}}
            {{^done}}{{num}}{{/done}}
        </div>
        <span class="step-label">{{name}}</span>
    </div>
    {{/steps}}
</div>

{{! ── Step content (pre-rendered by PHP from register_step{N}.mustache) ── }}
{{{step_content}}}

{{! ── Cancel registration (steps 2–4 only) — always at the very bottom ── }}
{{#show_cancel}}
<div class="wizard-cancel-row">
    <form method="post" action="{{{wwwroot}}}/local/mru/register.php" style="display:inline">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="cancel">
        <button type="submit" class="btn-wizard-cancel">Cancel registration</button>
    </form>
</div>
{{/show_cancel}}

{{#js}}
require(['local_mru/register'], function(Register) {
    Register.init();
});
{{/js}}
