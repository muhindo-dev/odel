{{!
    @template local_mru/register_step2
    Step 2: Email verification — send OTP, enter code, verify.
}}
<div class="wizard-panel" data-step="2">
    <div class="wizard-header">
        <h1 class="login-heading">Verify Your Email</h1>
        {{#email_verified}}
        <p class="login-subheading">Your email is already verified. Continue to the next step.</p>
        {{/email_verified}}
        {{^email_verified}}
        <p class="login-subheading">Enter your MRU email to receive a verification code.</p>
        {{/email_verified}}
    </div>

    {{! ── Already-verified state (arrived here via Back from step 3) ── }}
    {{#email_verified}}
    <div class="wizard-body">
        <div class="reg-account-email">
            <i class="fa fa-envelope" aria-hidden="true"></i>
            <span>{{email}}</span>
            <span class="verified-badge"><i class="fa fa-check-circle" aria-hidden="true"></i> Verified</span>
        </div>
        <p class="mru-field-hint mt-2">Your email address is already verified. You can continue or go back to step 1.</p>
    </div>
    <form method="post" action="{{{wwwroot}}}/local/mru/register.php" id="form-proceed" style="display:none">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="proceed">
    </form>
    <form method="post" action="{{{wwwroot}}}/local/mru/register.php" id="form-back-s2v" style="display:none">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="back">
    </form>
    <div class="wizard-footer">
        <button type="submit" form="form-back-s2v" class="btn-wizard-back">
            <i class="fa fa-arrow-left" aria-hidden="true"></i> Back
        </button>
        <button type="submit" form="form-proceed" class="btn-wizard-next">
            Continue <i class="fa fa-arrow-right" aria-hidden="true"></i>
        </button>
    </div>
    {{/email_verified}}

    {{! ── Normal verification flow ── }}
    {{^email_verified}}
    <div class="wizard-body mru-form">
        {{! Shared hidden back form — referenced by both footers below }}
        <form method="post" action="{{{wwwroot}}}/local/mru/register.php" id="form-back-s2" style="display:none">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="back">
        </form>

        {{! ── Phase 1: Enter email & request OTP ── }}
        {{^otp_sent}}
        <form method="post" action="{{{wwwroot}}}/local/mru/register.php" id="form-sendotp" class="reg-email-form">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="sendotp">
            <div class="mru-field-group">
                <label for="reg-email">MRU Email Address</label>
                <div class="mru-input-icon">
                    <i class="fa fa-envelope" aria-hidden="true"></i>
                    <input type="email"
                           id="reg-email"
                           name="email"
                           class="form-control"
                           value="{{email}}"
                           placeholder="yourname@mru.ac.ug"
                           required
                           autocomplete="email"
                           pattern=".+@mru\.ac\.ug$">
                </div>
                <div class="mru-field-hint">Must end with <strong>@mru.ac.ug</strong></div>
            </div>
        </form>
        <div class="wizard-footer">
            <button type="submit" form="form-back-s2" class="btn-wizard-back">
                <i class="fa fa-arrow-left" aria-hidden="true"></i> Back
            </button>
            <button type="submit" form="form-sendotp" class="btn-wizard-next">
                Send Verification Code <i class="fa fa-paper-plane" aria-hidden="true"></i>
            </button>
        </div>
        {{/otp_sent}}

        {{! ── Phase 2: Enter OTP code ── }}
        {{#otp_sent}}
        <div class="reg-account-email mb-3">
            <i class="fa fa-envelope" aria-hidden="true"></i>
            <span>Code sent to <strong>{{email}}</strong></span>
        </div>

        <form method="post" action="{{{wwwroot}}}/local/mru/register.php" id="form-verifyotp" class="reg-otp-form">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="verifyotp">
            <div class="mru-field-group">
                <label for="reg-otp">6-Digit Verification Code</label>
                <div class="mru-input-icon">
                    <i class="fa fa-key" aria-hidden="true"></i>
                    <input type="text"
                           id="reg-otp"
                           name="otp"
                           class="form-control otp-single"
                           maxlength="6"
                           inputmode="numeric"
                           pattern="[0-9]{6}"
                           placeholder="Enter 6-digit code"
                           required
                           autocomplete="one-time-code">
                </div>
            </div>
        </form>
        <div class="wizard-footer">
            <button type="submit" form="form-back-s2" class="btn-wizard-back">
                <i class="fa fa-arrow-left" aria-hidden="true"></i> Back
            </button>
            <button type="submit" form="form-verifyotp" class="btn-wizard-next">
                <i class="fa fa-check-circle" aria-hidden="true"></i> Verify Code
            </button>
        </div>
        <div class="reg-resend-row">
            <span>Didn't receive the code?</span>
            <form method="post" action="{{{wwwroot}}}/local/mru/register.php" style="display:inline;">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="resendotp">
                <button type="submit" class="btn-link-subtle">Resend Code</button>
            </form>
        </div>
        {{/otp_sent}}
    </div>
    {{/email_verified}}
</div>
