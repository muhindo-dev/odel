{{!
    @template theme_mru_odel/login
    MRU ODEL Login — clean split layout with photo panel + form panel.

    Example context (json):
    {
        "sitename": "MRU ODEL",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Login",
            "favicon": "favicon.ico",
            "main_content": "<h1>Login form</h1>"
        },
        "bodyattributes": "",
        "loginheading": "Welcome Back",
        "loginsubheading": "Muteesa I Royal University",
        "siteyear": "2026",
        "wwwroot": ""
    }
}}
{{> theme_mru_odel/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
{{{ output.standard_top_of_body_html }}}

<div class="mru-login-wrapper" id="page-wrapper">

    {{! ── Left photo panel (desktop only) ── }}
    <div class="mru-login-brand d-none d-lg-flex"
         style="background-image: url('{{{wwwroot}}}/theme/mru_odel/pix/frontpage/students.jpg');">
        <div class="brand-overlay"></div>
        <div class="brand-top">
            <div class="login-logo">MRU<span class="accent">ODEL</span></div>
            <p class="login-university">Muteesa I Royal University</p>
        </div>
        <div class="brand-bottom">
            <p class="login-motto">
                <i class="fa fa-quote-left"></i>
                Seeking Greater Horizon — In Thoughts and Actions
            </p>
            <div class="login-badges">
                <span class="login-badge"><i class="fa fa-shield"></i> Chartered 2024</span>
                <span class="login-badge"><i class="fa fa-certificate"></i> NCHE Licensed</span>
            </div>
        </div>
    </div>

    {{! ── Right form panel ── }}
    <div class="mru-login-form">
        <div class="login-form-inner">

            {{! Mobile logo }}
            <div class="login-mobile-header d-flex d-lg-none align-items-center gap-2 mb-4">
                <div class="login-mobile-icon">M</div>
                <div>
                    <div class="login-mobile-brand">MRU<span class="accent">ODEL</span></div>
                    <small class="login-mobile-sub">Muteesa I Royal University</small>
                </div>
            </div>

            <h1 class="login-heading">{{loginheading}}</h1>
            <p class="login-subheading">{{loginsubheading}}</p>

            {{! Moodle login form }}
            <div id="page-content" class="login-form">
                <div id="region-main-box">
                    <div id="region-main">
                        {{{ output.main_content }}}
                    </div>
                </div>
            </div>

            {{! Footer }}
            <div class="login-footer-note">
                <p>&copy; {{siteyear}} Muteesa I Royal University</p>
                <p>Need help? <a href="mailto:odel@mru.ac.ug">odel@mru.ac.ug</a></p>
            </div>

        </div>
    </div>

</div>

{{{ output.standard_end_of_body_html }}}
{{{ output.standard_footer_html }}}

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_mru_odel/theme'], function(Loader, MRUTheme) {
    MRUTheme.initLogin();
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
