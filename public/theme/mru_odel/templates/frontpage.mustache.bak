{{!
    @template theme_mru_odel/frontpage
    MRU ODEL — Custom academic homepage with hero, stats, departments, courses, notices
}}
{{> theme_mru_odel/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<a href="#mru-main-content" id="mru-skip-link" class="visually-hidden-focusable">Skip to main content</a>

<div id="page-wrapper">
    {{{ output.standard_top_of_body_html }}}

    {{> theme_mru_odel/navbar }}

    {{! Course Index Drawer }}
    {{#courseindex}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-courseindex{{/id}}
            {{$drawerheadercontent}}{{> theme_boost/courseindexdrawercontrols}}{{/drawerheadercontent}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}  {{{courseindex}}}  {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/courseindex}}
    {{#hasblocks}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/hasblocks}}

    <div id="page" data-region="mainpage" data-usertour="scroller"
         class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">

            {{! Drawer toggles (for logged in users) }}
            {{#isloggedin}}
            <div class="drawer-toggles d-flex d-print-none">
                {{#courseindex}}
                    <div class="drawer-toggler drawer-left-toggle open-nav">
                        <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle"
                                data-target="theme_boost-drawers-courseindex"
                                data-bs-toggle="tooltip" data-bs-placement="right"
                                title="{{#str}}opendrawerindex, core{{/str}}">
                            <span class="visually-hidden">{{#str}}opendrawerindex, core{{/str}}</span>
                            {{#pix}} t/index_drawer, moodle {{/pix}}
                        </button>
                    </div>
                {{/courseindex}}
                {{#hasblocks}}
                    <div class="drawer-toggler drawer-right-toggle ms-auto">
                        <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle"
                                data-target="theme_boost-drawers-blocks"
                                data-bs-toggle="tooltip" data-bs-placement="left"
                                title="{{#str}}opendrawerblocks, core{{/str}}">
                            <span class="visually-hidden">{{#str}}opendrawerblocks, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}}t/blocks_drawer, core{{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}}t/blocks_drawer_rtl, core{{/pix}}</span>
                        </button>
                    </div>
                {{/hasblocks}}
            </div>
            {{/isloggedin}}

            {{! ════════════════════════════════════════════════════════════════ }}
            {{! HERO SECTION }}
            {{! ════════════════════════════════════════════════════════════════ }}
            <section class="mru-hero d-print-none" aria-label="Welcome to MRU ODEL">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-7 col-xl-6">

                            <div class="mru-hero-eyebrow">
                                <span class="dot"></span>
                                Open &amp; Distance E-Learning Platform
                            </div>

                            {{#isloggedin}}
                            <h1>Welcome back,<br><span class="highlight">{{firstname}}</span></h1>
                            {{/isloggedin}}
                            {{^isloggedin}}
                            <h1>Muteesa I<br><span class="highlight">Royal University</span></h1>
                            {{/isloggedin}}

                            <p class="mru-hero-sub">
                                Uganda's premier open and distance learning institution — delivering quality, accredited higher education to students across East Africa and beyond.
                            </p>

                            <p class="mru-hero-motto">
                                Seeking Greater Horizon In Thoughts and Actions
                            </p>

                            <div class="mru-hero-actions">
                                {{#isloggedin}}
                                <a href="{{{wwwroot}}}/my/" class="btn-hero-primary">
                                    ⊞ &nbsp;My Dashboard
                                </a>
                                <a href="{{{wwwroot}}}/course/" class="btn-hero-outline">
                                    📚 &nbsp;Browse Courses
                                </a>
                                {{/isloggedin}}
                                {{^isloggedin}}
                                <a href="{{{wwwroot}}}/course/" class="btn-hero-primary">
                                    📚 &nbsp;Browse Courses
                                </a>
                                <a href="{{{wwwroot}}}/login/" class="btn-hero-outline">
                                    → &nbsp;Student Login
                                </a>
                                {{/isloggedin}}
                            </div>

                        </div>

                        {{! Right side — accreditation & quick facts panel }}
                        <div class="col-lg-5 col-xl-6 d-none d-lg-block">
                            <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);padding:1.5rem;margin-left:2rem;">
                                <div style="font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.4);margin-bottom:1rem;">Accredited & Recognised By</div>
                                <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1.5rem;">
                                    <span style="border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.6);padding:.25rem .6rem;font-size:.65rem;font-weight:700;letter-spacing:.05em;">NCHE</span>
                                    <span style="border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.6);padding:.25rem .6rem;font-size:.65rem;font-weight:700;letter-spacing:.05em;">NEMRA</span>
                                    <span style="border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.6);padding:.25rem .6rem;font-size:.65rem;font-weight:700;letter-spacing:.05em;">RENU</span>
                                    <span style="border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.6);padding:.25rem .6rem;font-size:.65rem;font-weight:700;letter-spacing:.05em;">GENSS</span>
                                    <span style="border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.6);padding:.25rem .6rem;font-size:.65rem;font-weight:700;letter-spacing:.05em;">AAU</span>
                                </div>
                                <div style="border-top:1px solid rgba(255,255,255,.07);padding-top:1rem;">
                                    <div style="font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.4);margin-bottom:.75rem;">Available On All Devices</div>
                                    <div style="display:flex;gap:.75rem;align-items:center;">
                                        <span style="color:rgba(255,255,255,.5);font-size:.75rem;">🖥 Desktop</span>
                                        <span style="color:rgba(255,255,255,.5);font-size:.75rem;">📱 Mobile</span>
                                        <span style="color:rgba(255,255,255,.5);font-size:.75rem;">⌚ Tablet</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            {{! ════════════════════════════════════════════════════════════════ }}
            {{! STATS BAR }}
            {{! ════════════════════════════════════════════════════════════════ }}
            <div class="mru-stats-bar d-print-none">
                <div class="container-fluid px-0">
                    <div class="mru-stats-grid">
                        <div class="stat-item">
                            <span class="stat-num">5,000+</span>
                            <span class="stat-lbl">Enrolled Students</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-num">236</span>
                            <span class="stat-lbl">Active Courses</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-num">52</span>
                            <span class="stat-lbl">Programmes</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-num">148</span>
                            <span class="stat-lbl">Academic Staff</span>
                        </div>
                    </div>
                </div>
            </div>

            {{! ════════════════════════════════════════════════════════════════ }}
            {{! MOODLE MAIN CONTENT (Course listing, blocks, etc.) }}
            {{! ════════════════════════════════════════════════════════════════ }}
            <div id="mru-main-content">
                {{! Section header for course listing }}
                <div style="background:#fff;border-bottom:2px solid #dde1ea;padding:.75rem 1.5rem;display:flex;align-items:center;justify-content:space-between;">
                    <div style="display:flex;align-items:center;gap:.75rem;">
                        <div style="width:4px;height:20px;background:#174DA4;"></div>
                        <span style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#0d2e68;">Available Courses</span>
                    </div>
                    <a href="{{{wwwroot}}}/course/" style="font-size:.72rem;font-weight:600;color:#174DA4;text-decoration:none;">View All →</a>
                </div>

                <div id="page-content" class="pb-3 d-print-block" style="background:#f5f6fa;">
                    <div id="region-main-box" class="container-fluid px-0">
                        {{#hasregionmainsettingsmenu}}
                            <div id="region-main-settings-menu" class="d-print-none">
                                <div>{{{ regionmainsettingsmenu }}}</div>
                            </div>
                        {{/hasregionmainsettingsmenu}}
                        <div id="region-main" style="margin:0;border-left:none;border-right:none;border-bottom:none;background:#fff;">
                            {{#hasregionmainsettingsmenu}}
                                <div class="region_main_settings_menu_proxy"></div>
                            {{/hasregionmainsettingsmenu}}
                            {{{ output.course_content_header }}}
                            {{#headercontent}}{{> core/activity_header }}{{/headercontent}}
                            {{#overflow}}
                                <div class="container-fluid tertiary-navigation">
                                    <div class="navitem">{{> core/url_select}}</div>
                                </div>
                            {{/overflow}}
                            {{{ output.main_content }}}
                            {{{ output.activity_navigation }}}
                            {{{ output.course_content_footer }}}
                        </div>
                    </div>
                </div>
            </div>

            {{! ════════════════════════════════════════════════════════════════ }}
            {{! DEPARTMENTS / FACULTIES }}
            {{! ════════════════════════════════════════════════════════════════ }}
            <div class="mru-section mru-section-light d-print-none">
                <div class="container">
                    <div class="mru-section-title">
                        <h2>Faculties &amp; Departments</h2>
                        <div class="line"></div>
                        <span class="badge-label">8 Faculties</span>
                    </div>
                    <div class="mru-dept-grid">
                        {{#departments}}
                        <div class="dept-item">
                            <div class="dept-icon">{{icon}}</div>
                            <div class="dept-name">{{name}}</div>
                            <div class="dept-count">{{courses}}</div>
                        </div>
                        {{/departments}}
                    </div>
                </div>
            </div>

            {{! ════════════════════════════════════════════════════════════════ }}
            {{! WHY CHOOSE MRU ODEL }}
            {{! ════════════════════════════════════════════════════════════════ }}
            <div class="mru-section mru-section-white d-print-none">
                <div class="container">
                    <div class="mru-section-title">
                        <h2>Why Choose MRU ODEL</h2>
                        <div class="line"></div>
                    </div>
                    <div class="mru-feature-grid">
                        {{#features}}
                        <div class="mru-feature-item">
                            <div class="feature-icon">{{icon}}</div>
                            <h3>{{title}}</h3>
                            <p>{{desc}}</p>
                        </div>
                        {{/features}}
                    </div>
                </div>
            </div>

            {{! ════════════════════════════════════════════════════════════════ }}
            {{! NOTICES & ANNOUNCEMENTS }}
            {{! ════════════════════════════════════════════════════════════════ }}
            <div class="mru-section d-print-none" style="background:#f5f6fa;">
                <div class="container">
                    <div class="row g-0" style="gap:1px;background:#dde1ea;border:1px solid #dde1ea;">

                        {{! Notices column }}
                        <div class="col-lg-7" style="background:#fff;padding:1.5rem;">
                            <div class="mru-section-title">
                                <h2>Latest Notices</h2>
                                <div class="line"></div>
                            </div>
                            <ul class="mru-notice-list">
                                {{#notices}}
                                <li>
                                    <div class="notice-date">
                                        <span class="day">{{day}}</span>
                                        <span class="mon">{{mon}}</span>
                                    </div>
                                    <div class="notice-content">
                                        <h4>{{title}}</h4>
                                        <p>{{desc}}</p>
                                    </div>
                                    <span class="notice-tag">{{tag}}</span>
                                </li>
                                {{/notices}}
                            </ul>
                        </div>

                        {{! Quick access column }}
                        <div class="col-lg-5" style="background:#fff;padding:1.5rem;">
                            <div class="mru-section-title">
                                <h2>Quick Access</h2>
                                <div class="line"></div>
                            </div>

                            <div style="display:flex;flex-direction:column;gap:1px;background:#dde1ea;border:1px solid #dde1ea;">
                                <a href="{{{wwwroot}}}/login/" style="display:flex;align-items:center;gap:.85rem;padding:.85rem 1rem;background:#fff;text-decoration:none;transition:all .15s;" onmouseover="this.style.background='#f5f6fa'" onmouseout="this.style.background='#fff'">
                                    <span style="width:36px;height:36px;background:rgba(23,77,164,.08);display:flex;align-items:center;justify-content:center;font-size:1rem;border-left:3px solid #174DA4;flex-shrink:0;">🔐</span>
                                    <div>
                                        <div style="font-size:.82rem;font-weight:700;color:#0d2e68;">Student Portal Login</div>
                                        <div style="font-size:.7rem;color:#9a9ab0;">Access your courses and grades</div>
                                    </div>
                                    <span style="margin-left:auto;color:#174DA4;font-size:.8rem;">→</span>
                                </a>
                                <a href="{{{wwwroot}}}/course/" style="display:flex;align-items:center;gap:.85rem;padding:.85rem 1rem;background:#fff;text-decoration:none;transition:all .15s;" onmouseover="this.style.background='#f5f6fa'" onmouseout="this.style.background='#fff'">
                                    <span style="width:36px;height:36px;background:rgba(23,77,164,.08);display:flex;align-items:center;justify-content:center;font-size:1rem;border-left:3px solid #174DA4;flex-shrink:0;">📚</span>
                                    <div>
                                        <div style="font-size:.82rem;font-weight:700;color:#0d2e68;">Course Catalogue</div>
                                        <div style="font-size:.7rem;color:#9a9ab0;">Browse all available programmes</div>
                                    </div>
                                    <span style="margin-left:auto;color:#174DA4;font-size:.8rem;">→</span>
                                </a>
                                <a href="https://mru.ac.ug/admissions" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:.85rem;padding:.85rem 1rem;background:#fff;text-decoration:none;transition:all .15s;" onmouseover="this.style.background='#f5f6fa'" onmouseout="this.style.background='#fff'">
                                    <span style="width:36px;height:36px;background:rgba(23,77,164,.08);display:flex;align-items:center;justify-content:center;font-size:1rem;border-left:3px solid #F2A900;flex-shrink:0;">📝</span>
                                    <div>
                                        <div style="font-size:.82rem;font-weight:700;color:#0d2e68;">Apply for Admission</div>
                                        <div style="font-size:.7rem;color:#9a9ab0;">Undergraduate &amp; postgraduate</div>
                                    </div>
                                    <span style="margin-left:auto;color:#174DA4;font-size:.8rem;">→</span>
                                </a>
                                <a href="mailto:odel@mru.ac.ug" style="display:flex;align-items:center;gap:.85rem;padding:.85rem 1rem;background:#fff;text-decoration:none;transition:all .15s;" onmouseover="this.style.background='#f5f6fa'" onmouseout="this.style.background='#fff'">
                                    <span style="width:36px;height:36px;background:rgba(23,77,164,.08);display:flex;align-items:center;justify-content:center;font-size:1rem;border-left:3px solid #174DA4;flex-shrink:0;">✉️</span>
                                    <div>
                                        <div style="font-size:.82rem;font-weight:700;color:#0d2e68;">ODEL Support</div>
                                        <div style="font-size:.7rem;color:#9a9ab0;">odel@mru.ac.ug</div>
                                    </div>
                                    <span style="margin-left:auto;color:#174DA4;font-size:.8rem;">→</span>
                                </a>
                                <a href="https://mru.ac.ug" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:.85rem;padding:.85rem 1rem;background:#fff;text-decoration:none;transition:all .15s;" onmouseover="this.style.background='#f5f6fa'" onmouseout="this.style.background='#fff'">
                                    <span style="width:36px;height:36px;background:rgba(23,77,164,.08);display:flex;align-items:center;justify-content:center;font-size:1rem;border-left:3px solid #174DA4;flex-shrink:0;">🌐</span>
                                    <div>
                                        <div style="font-size:.82rem;font-weight:700;color:#0d2e68;">University Website</div>
                                        <div style="font-size:.7rem;color:#9a9ab0;">mru.ac.ug</div>
                                    </div>
                                    <span style="margin-left:auto;color:#174DA4;font-size:.8rem;">↗</span>
                                </a>
                            </div>

                            {{! Contact strip }}
                            <div style="margin-top:1px;background:#071a3e;padding:.9rem 1rem;display:flex;align-items:center;gap:.75rem;">
                                <span style="font-size:1.1rem;">📍</span>
                                <div>
                                    <div style="font-size:.72rem;font-weight:700;color:#fff;">Muteesa I Royal University</div>
                                    <div style="font-size:.68rem;color:rgba(255,255,255,.45);">Masulita, Wakiso District, Uganda</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            {{! Footer }}
            {{> theme_mru_odel/footer }}

        </div>{{! end #topofscroll }}
    </div>{{! end #page }}

    {{{ output.standard_after_main_region_html }}}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer', 'theme_mru_odel/theme'], function(Loader, Drawer, MRUTheme) {
    Drawer.init();
    MRUTheme.init();
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
